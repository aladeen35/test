# Supabase project credentials (Settings → API in the Supabase dashboard).
# The anon key is safe for the browser; NEVER put the service-role key here.
# Without these values the app runs in the local two-tab development mode.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
