<?xml version="1.0" encoding="utf-8"?>
<!-- خلفية الودجات: جلد بني متدرّج، إطار ذهبي، وخياطة ذهبية منقّطة من الداخل -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#FF8A5528"
                android:centerColor="#FF5A3418"
                android:endColor="#FF3A1F0C" />
            <corners android:radius="22dp" />
            <stroke android:width="1.6dp" android:color="#FFD4A017" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#59F6D58B"
                android:dashWidth="5dp"
                android:dashGap="3dp" />
        </shape>
    </item>
</layer-list>
