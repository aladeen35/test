<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت القطوعات المختصرة (3×1): الحالة | التغيير الجاي والعدّاد — نفس المعرّفات الأساسية -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/hw_pv_pw_title"
            android:textColor="@color/hw_gold_light"
            android:textSize="9sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pw_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pw_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="@color/hw_shadow"
                    android:shadowDy="1.5"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="@string/hw_pv_pw_status"
                    android:textColor="#FF8EE59B"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/pw_sched"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/hw_pv_pw_sched"
                    android:textColor="@color/hw_cream_dim"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/hw_divider_v" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pw_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/hw_pv_pw_next"
                    android:textColor="@color/hw_cream"
                    android:textSize="11sp" />

                <Chronometer
                    android:id="@+id/pw_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/hw_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/hw_gold_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/pw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hw_open_app"
            android:textColor="@color/hw_cream"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
