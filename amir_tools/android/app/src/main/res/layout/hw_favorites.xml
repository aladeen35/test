<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت المفضلة (4×2): رأس بالشعار والعنوان والعلم، ثم صفّان من 4 بلاطات -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fav_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/fav_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="3dp">

            <ImageView
                android:id="@+id/fav_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/hw_app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/hw_logo" />

            <TextView
                android:id="@+id/fav_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="@color/hw_shadow"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:singleLine="true"
                android:text="@string/hw_app_name"
                android:textColor="@color/hw_gold_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/fav_flag"
                android:layout_width="20dp"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/hw_flag" />
        </LinearLayout>

        <ImageView
            android:id="@+id/fav_div"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="3dp"
            android:contentDescription="@null"
            android:src="@drawable/hw_divider"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/fav_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/hw_open_app"
            android:textColor="@color/hw_cream"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fav_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/fav_t0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
            <ImageView
                android:id="@+id/fav_t1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
            <ImageView
                android:id="@+id/fav_t2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
            <ImageView
                android:id="@+id/fav_t3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fav_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/fav_t4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
            <ImageView
                android:id="@+id/fav_t5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
            <ImageView
                android:id="@+id/fav_t6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
            <ImageView
                android:id="@+id/fav_t7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="false"
                android:contentDescription="@string/hw_app_name"
                android:src="@drawable/hw_tile_ph" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
