<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت القطوعات (3×2): الحالة الآن، التغيير الجاي مع عدّاد، وقطوعات اليوم الباقية -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:padding="10dp">

    <ImageView
        android:id="@+id/pw_flag"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/hw_flag" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/hw_pv_pw_title"
            android:textColor="@color/hw_gold_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/pw_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pw_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/hw_shadow"
                android:shadowDy="1.5"
                android:shadowRadius="3"
                android:singleLine="true"
                android:text="@string/hw_pv_pw_status"
                android:textColor="#FF8EE59B"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/pw_sched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/hw_pv_pw_sched"
                android:textColor="@color/hw_cream_dim"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pw_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/hw_pv_pw_next"
                    android:textColor="@color/hw_cream"
                    android:textSize="12sp" />

                <Chronometer
                    android:id="@+id/pw_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/hw_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/hw_gold_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/pw_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/hw_divider" />

            <TextView
                android:id="@+id/pw_today_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="@string/hw_pv_pw_today_l"
                android:textColor="@color/hw_gold_light"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/pw_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="3"
                android:text="@string/hw_pv_pw_today"
                android:textColor="@color/hw_cream"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pw_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/hw_open_app"
            android:textColor="@color/hw_cream"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
