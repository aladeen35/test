<?xml version="1.0" encoding="utf-8"?>
<!-- ودجت الدولار (2×1 / 3×1): الموازي | الرسمي بفاصل ذهبي، ووقت آخر تحديث -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fx_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hw_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/hw_pv_fx_title"
            android:textColor="@color/hw_gold_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fx_par_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/hw_pv_fx_par_l"
                    android:textColor="@color/hw_cream_dim"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/fx_par"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:shadowColor="@color/hw_shadow"
                    android:shadowDy="1.5"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="2,650"
                    android:textColor="@color/hw_gold_text"
                    android:textSize="18sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/hw_divider_v" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fx_off_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/hw_pv_fx_off_l"
                    android:textColor="@color/hw_cream_dim"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/fx_off"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="600"
                    android:textColor="@color/hw_cream"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/fx_upd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/hw_pv_fx_upd"
            android:textColor="@color/hw_cream_dim"
            android:textSize="8sp" />
    </LinearLayout>
</FrameLayout>
